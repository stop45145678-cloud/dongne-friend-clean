rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdultProfile(data) {
      return data.age is int
        && data.age >= 19
        && data.adultVerified == true;
    }
    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && isAdultProfile(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == userId
        && isAdultProfile(request.resource.data);
    }

    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
